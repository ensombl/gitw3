{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new repo">
	<div class="ui middle very relaxed page one column grid">
		<div class="column">
			<form id="platform-port-form" class="ui form" action="{{AppSubUrl}}/repo/create/port" method="post">
				{{.CsrfTokenHtml}}
				<h2 class="ui top attached header">{{ctx.Locale.Tr "platform.port.title"}}</h2>
				<div class="ui attached segment">
					{{template "base/alert" .}}
					<p class="platform-port-lead">{{ctx.Locale.Tr "platform.port.explanation"}}</p>
					{{if or .CanCreateRepo .Orgs}}
						{{if and (not .CanCreateRepo) (ne .MaxCreationLimit 0)}}
							<div class="ui negative message">
								<p>{{ctx.Locale.TrN .MaxCreationLimit "repo.form.reach_limit_of_creation_1" "repo.form.reach_limit_of_creation_n" .MaxCreationLimit}}</p>
							</div>
						{{end}}
						<fieldset class="platform-wizard-panel">
							<legend>{{ctx.Locale.Tr "platform.port.repo_heading"}}</legend>
							<p>{{ctx.Locale.Tr "platform.port.repo_help"}}</p>
							{{template "repo/create_platform_basic" .}}
							<label>{{ctx.Locale.Tr "repo.default_branch"}}<input name="default_branch" value="{{.default_branch}}" required></label>
							<input type="hidden" name="object_format_name" value="{{.DefaultObjectFormat.Name}}">
						</fieldset>
						<div class="ui info message platform-port-deferred-note">
							<div class="header">{{ctx.Locale.Tr "platform.port.deferred_title"}}</div>
							<p>{{ctx.Locale.Tr "platform.port.deferred_help"}}</p>
						</div>
						<div class="platform-wizard-actions tw-flex tw-items-center">
							<a class="ui button" href="{{AppSubUrl}}/repo/create">{{ctx.Locale.Tr "cancel"}}</a>
							<button class="ui primary button tw-ml-auto" type="submit">{{ctx.Locale.Tr "platform.port.create"}}</button>
						</div>
					{{else}}
						<div class="ui negative message">
							<p>{{ctx.Locale.Tr "repo.form.cannot_create"}}</p>
						</div>
					{{end}}
				</div>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
