{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new repo">
	<div class="ui middle very relaxed page one column grid">
		<div class="column">
			<form id="platform-port-form" class="ui form" action="{{AppSubUrl}}/repo/create/port" method="post" data-platform-port>
				{{.CsrfTokenHtml}}
				<h2 class="ui top attached header">{{ctx.Locale.Tr "platform.port.title"}}</h2>
				<div class="ui attached segment">
					{{template "base/alert" .}}
					<p class="platform-port-lead">{{ctx.Locale.Tr "platform.port.explanation"}}</p>
					<ol class="platform-wizard-steps three-steps" aria-label="{{ctx.Locale.Tr "platform.port.title"}}">
						<li class="platform-wizard-step active" data-platform-port-indicator="1"><span class="platform-wizard-step-number">1</span><span>{{ctx.Locale.Tr "platform.port.source_step"}}</span></li>
						<li class="platform-wizard-step" data-platform-port-indicator="2"><span class="platform-wizard-step-number">2</span><span>{{ctx.Locale.Tr "platform.port.repo_step"}}</span></li>
						<li class="platform-wizard-step" data-platform-port-indicator="3"><span class="platform-wizard-step-number">3</span><span>{{ctx.Locale.Tr "platform.port.sign_step"}}</span></li>
					</ol>
					<fieldset class="platform-wizard-panel" data-platform-port-step="1">
						<legend>{{ctx.Locale.Tr "platform.port.source_heading"}}</legend>
						<p>{{ctx.Locale.Tr "platform.port.source_help"}}</p>
						<label class="required field">{{ctx.Locale.Tr "platform.port.ename"}}<input name="ename" required maxlength="255" placeholder="@your-platform"></label>
						<label class="required field">{{ctx.Locale.Tr "platform.port.token"}}<input name="token" type="password" required maxlength="32768" autocomplete="off"></label>
						<div class="ui info message"><p>{{ctx.Locale.Tr "platform.port.token_privacy"}}</p></div>
					</fieldset>
					<fieldset class="platform-wizard-panel tw-hidden" data-platform-port-step="2" hidden>
						<legend>{{ctx.Locale.Tr "platform.port.repo_heading"}}</legend>
						<p>{{ctx.Locale.Tr "platform.port.repo_help"}}</p>
						{{template "repo/create_platform_basic" .}}
						<label>{{ctx.Locale.Tr "repo.default_branch"}}<input name="default_branch" value="{{.default_branch}}" required></label>
					</fieldset>
					<fieldset class="platform-wizard-panel tw-hidden" data-platform-port-step="3" hidden>
						<legend>{{ctx.Locale.Tr "platform.port.sign_heading"}}</legend>
						<p>{{ctx.Locale.Tr "platform.port.sign_help"}}</p>
						<div class="ui warning message"><div class="header">{{ctx.Locale.Tr "platform.port.staged_title"}}</div><p>{{ctx.Locale.Tr "platform.port.staged_help"}}</p></div>
					</fieldset>
					<div class="platform-wizard-actions tw-flex tw-items-center tw-mt-4">
						<button class="ui button tw-hidden" type="button" data-platform-port-back hidden>{{ctx.Locale.Tr "platform.create.back"}}</button>
						<button class="ui primary button tw-ml-auto" type="button" data-platform-port-next>{{ctx.Locale.Tr "platform.create.next"}}</button>
						<button class="ui primary button tw-ml-auto tw-hidden" type="submit" data-platform-port-submit hidden>{{ctx.Locale.Tr "platform.port.authorize"}}</button>
					</div>
				</div>
			</form>
			<dialog id="platform-port-signing-modal">
				<div class="header">{{ctx.Locale.Tr "platform.port.signing_title"}}</div>
				<div class="content w3ds-ppa-signing-content">
					<p>{{ctx.Locale.Tr "platform.port.signing_help"}}</p>
					<div class="w3ds-ppa-signing-qr"><canvas data-platform-port-qr aria-label="{{ctx.Locale.Tr "platform.ppa.signing_qr"}}"></canvas></div>
					<a class="ui primary button" data-platform-port-open href="#">{{ctx.Locale.Tr "platform.ppa.signing_open"}}</a>
					<p class="w3ds-ppa-signing-status" data-platform-port-status data-starting="{{ctx.Locale.Tr "platform.ppa.signing_starting"}}" data-waiting="{{ctx.Locale.Tr "platform.port.signing_waiting"}}" data-complete="{{ctx.Locale.Tr "platform.port.signing_complete"}}" data-failed="{{ctx.Locale.Tr "platform.port.signing_failed"}}" aria-live="polite"></p>
				</div>
				<div class="actions"><button class="ui button" data-modal-close>{{ctx.Locale.Tr "cancel"}}</button></div>
			</dialog>
		</div>
	</div>
</div>
{{template "base/footer" .}}
