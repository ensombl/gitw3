{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository">
	{{template "repo/header" .}}
	<div id="w3ds-platform-page" class="ui container"{{if .IsW3DSPlatform}} data-w3ds-status-url="{{.RepoLink}}/w3ds/status" data-w3ds-poll-interval="5000" data-w3ds-checked-text="{{ctx.Locale.Tr "platform.status.checked"}}" data-w3ds-refresh-failed-text="{{ctx.Locale.Tr "platform.status.refresh_failed"}}"{{end}}>
		{{template "base/alert" .}}
		{{if .W3DSOnboarded}}
			<div class="ui positive message">
				<div class="header">{{ctx.Locale.Tr "platform.status.created"}}</div>
				<p>{{ctx.Locale.Tr "platform.status.created_help"}}</p>
				{{if .W3DSUseAI}}
					<p>{{ctx.Locale.Tr "platform.status.ai_help"}}</p>
					<div class="ui action input fluid"><input readonly value="npx skills add MetaState-Prototype-Project/prototype@w3ds"><button type="button" class="ui button" data-clipboard-text="npx skills add MetaState-Prototype-Project/prototype@w3ds">{{ctx.Locale.Tr "copy"}}</button></div>
				{{end}}
			</div>
		{{end}}

		{{if .IsW3DSPlatform}}
			{{$publication := .PlatformPublication}}
			{{$manifest := .PlatformManifest}}
			{{$edit := .PlatformEditForm}}
			<div class="w3ds-page-heading">
				<div>
					<h1>{{ctx.Locale.Tr "platform.repo.heading"}}</h1>
					<p>{{ctx.Locale.Tr "platform.repo.intro"}}</p>
				</div>
				{{if .CanEditW3DS}}
					<a class="ui primary button" href="#w3ds-platform-edit">{{svg "octicon-pencil"}} {{ctx.Locale.Tr "platform.edit.action"}}</a>
				{{else}}
					<a class="ui basic button" href="{{.RepoLink}}/src/branch/{{PathEscapeSegments .Repository.DefaultBranch}}/{{.PlatformManifestPath}}">{{svg "octicon-file-code"}} {{ctx.Locale.Tr "platform.repo.view_manifest"}}</a>
				{{end}}
			</div>

			<section class="w3ds-section" aria-labelledby="w3ds-live-heading">
				<h2 id="w3ds-live-heading">{{ctx.Locale.Tr "platform.repo.live_status"}}</h2>
				<p class="w3ds-section-help">{{ctx.Locale.Tr "platform.repo.live_help"}}</p>
				<div id="w3ds-publication-status" data-status="{{$publication.Status}}" class="ui {{if eq $publication.Status "published"}}positive{{else if or (eq $publication.Status "failed") (eq $publication.Status "archived")}}warning{{else}}info{{end}} message">
					{{if eq $publication.Status "published"}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.published"}}</div><p data-w3ds-status-message>{{ctx.Locale.Tr "platform.status.published_help" .PlatformEName}}</p>
					{{else if eq $publication.Status "failed"}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.failed"}}</div><p data-w3ds-status-message>{{ctx.Locale.Tr "platform.status.failed_help"}}</p>
					{{else if eq $publication.Status "archived"}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.archived"}}</div><p data-w3ds-status-message></p>
					{{else if eq $publication.Status "publishing"}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.publishing"}}</div><p data-w3ds-status-message>{{ctx.Locale.Tr "platform.status.pending_help"}}</p>
					{{else if eq $publication.Status "unavailable"}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.unavailable"}}</div><p data-w3ds-status-message>{{ctx.Locale.Tr "platform.status.unavailable_help"}}</p>
					{{else}}
						<div class="header" data-w3ds-status-title>{{ctx.Locale.Tr "platform.status.identity_pending"}}</div><p data-w3ds-status-message>{{ctx.Locale.Tr "platform.status.pending_help"}}</p>
					{{end}}
					{{if $.Permission.IsAdmin}}<p data-w3ds-status-error class="{{if not $publication.LastError}}tw-hidden{{end}}"><code>{{$publication.LastError}}</code></p>{{end}}
				</div>
				<p class="w3ds-status-checked" data-w3ds-status-checked aria-live="polite">{{ctx.Locale.Tr "platform.status.checking"}}</p>
			</section>

			<section class="w3ds-section" aria-labelledby="w3ds-guide-heading">
				<h2 id="w3ds-guide-heading">{{ctx.Locale.Tr "platform.repo.guide_title"}}</h2>
				<p class="w3ds-section-help">{{ctx.Locale.Tr "platform.repo.guide_help"}}</p>
				<ol class="w3ds-guide">
					<li class="complete"><span class="w3ds-guide-number">1</span><div><div class="w3ds-guide-title">{{ctx.Locale.Tr "platform.repo.step_manifest"}} <span class="ui green label">{{ctx.Locale.Tr "platform.repo.ready"}}</span></div><p>{{ctx.Locale.Tr "platform.repo.step_manifest_help"}}</p></div></li>
					<li class="{{if .PlatformIdentityReady}}complete{{end}}" data-w3ds-identity-step><span class="w3ds-guide-number">2</span><div><div class="w3ds-guide-title">{{ctx.Locale.Tr "platform.repo.step_identity"}} <span class="ui {{if .PlatformIdentityReady}}green{{else}}blue{{end}} label" data-w3ds-step-label>{{if .PlatformIdentityReady}}{{ctx.Locale.Tr "platform.repo.ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.automatic"}}{{end}}</span></div><p data-w3ds-step-message>{{if .PlatformIdentityReady}}{{ctx.Locale.Tr "platform.repo.step_identity_ready" .PlatformEName}}{{else}}{{ctx.Locale.Tr "platform.repo.step_identity_pending"}}{{end}}</p></div></li>
					<li class="{{if .PlatformPublished}}complete{{end}}" data-w3ds-marketplace-step><span class="w3ds-guide-number">3</span><div><div class="w3ds-guide-title">{{ctx.Locale.Tr "platform.repo.step_marketplace"}} <span class="ui {{if .PlatformPublished}}green{{else}}blue{{end}} label" data-w3ds-step-label>{{if .PlatformPublished}}{{ctx.Locale.Tr "platform.repo.ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.waiting"}}{{end}}</span></div><p data-w3ds-step-message>{{if .PlatformPublished}}{{ctx.Locale.Tr "platform.repo.step_marketplace_ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.step_marketplace_pending"}}{{end}}</p></div></li>
					<li class="{{if $manifest.URL}}complete{{end}}" data-w3ds-application-step><span class="w3ds-guide-number">4</span><div><div class="w3ds-guide-title">{{ctx.Locale.Tr "platform.repo.step_application"}} <span class="ui {{if $manifest.URL}}green{{else}}grey{{end}} label" data-w3ds-step-label>{{if $manifest.URL}}{{ctx.Locale.Tr "platform.repo.ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.waiting"}}{{end}}</span></div><p data-w3ds-step-message>{{if $manifest.URL}}{{ctx.Locale.Tr "platform.repo.step_application_ready" $manifest.URL}}{{else}}{{ctx.Locale.Tr "platform.repo.step_application_missing"}}{{end}}</p></div></li>
				</ol>
			</section>

			<section id="w3ds-platform-edit" class="w3ds-section" aria-labelledby="w3ds-details-heading">
				<h2 id="w3ds-details-heading">{{ctx.Locale.Tr "platform.repo.details"}}</h2>
				{{if .CanEditW3DS}}
					<p class="w3ds-section-help">{{ctx.Locale.Tr "platform.edit.help"}}</p>
					<form class="ui form" action="{{.RepoLink}}/w3ds" method="post">
						<input type="hidden" name="last_commit_id" value="{{$edit.LastCommitID}}">
						<div class="w3ds-edit-grid">
							<div class="required field {{if .Err_PlatformDisplayName}}error{{end}}">
								<label for="platform_display_name">{{ctx.Locale.Tr "platform.repo.display_name"}}</label>
								<input id="platform_display_name" name="platform_display_name" value="{{$edit.PlatformDisplayName}}" maxlength="100" required>
							</div>
							<div class="required field {{if .Err_PlatformVersion}}error{{end}}">
								<label for="platform_version">{{ctx.Locale.Tr "platform.repo.version"}}</label>
								<input id="platform_version" name="platform_version" value="{{$edit.PlatformVersion}}" maxlength="100" placeholder="0.1.0" required>
							</div>
						</div>
						<div class="required field {{if .Err_PlatformDescription}}error{{end}}">
							<label for="platform_description">{{ctx.Locale.Tr "platform.edit.description"}}</label>
							<textarea id="platform_description" name="platform_description" rows="4" maxlength="2048" required>{{$edit.PlatformDescription}}</textarea>
						</div>
						<div class="w3ds-edit-grid">
							<div class="required field {{if .Err_PlatformCategory}}error{{end}}">
								<label for="platform_category">{{ctx.Locale.Tr "platform.repo.category"}}</label>
								<select id="platform_category" name="platform_category" required>
									{{range $category := .PlatformCategories}}<option value="{{$category}}" {{if eq $edit.PlatformCategory $category}}selected{{end}}>{{$category}}</option>{{end}}
								</select>
							</div>
							<div class="field {{if .Err_PlatformURL}}error{{end}}">
								<label for="platform_url">{{ctx.Locale.Tr "platform.repo.application_url"}}</label>
								<input id="platform_url" name="platform_url" type="url" value="{{$edit.PlatformURL}}" maxlength="2048" placeholder="https://my-platform.example">
								<span class="help">{{ctx.Locale.Tr "platform.edit.application_help"}}</span>
							</div>
						</div>
						<div class="field {{if .Err_PlatformLogoURL}}error{{end}}">
							<label for="platform_logo_url">{{ctx.Locale.Tr "platform.edit.logo_url"}}</label>
							<input id="platform_logo_url" name="platform_logo_url" type="url" value="{{$edit.PlatformLogoURL}}" maxlength="2048" placeholder="https://my-platform.example/logo.png">
						</div>
						<div class="ui info message w3ds-stable-identity">
							<div class="header">{{ctx.Locale.Tr "platform.edit.stable_title"}}</div>
							<p>{{ctx.Locale.Tr "platform.edit.stable_help" $manifest.PlatformName}}</p>
						</div>
						<div class="w3ds-edit-actions">
							<button type="submit" class="ui primary button">{{svg "octicon-check"}} {{ctx.Locale.Tr "platform.edit.save"}}</button>
							<span>{{ctx.Locale.Tr "platform.edit.commit_help"}}</span>
						</div>
					</form>
				{{else}}
					<dl class="w3ds-details">
						<div><dt>{{ctx.Locale.Tr "platform.repo.display_name"}}</dt><dd>{{$manifest.DisplayName}}</dd></div>
						<div><dt>{{ctx.Locale.Tr "platform.repo.version"}}</dt><dd>{{$manifest.Version}}</dd></div>
						<div><dt>{{ctx.Locale.Tr "platform.repo.category"}}</dt><dd>{{$manifest.Category}}</dd></div>
						<div><dt>{{ctx.Locale.Tr "platform.repo.application_url"}}</dt><dd>{{if $manifest.URL}}<a href="{{$manifest.URL}}" rel="noopener noreferrer">{{$manifest.URL}}</a>{{else}}{{ctx.Locale.Tr "platform.repo.not_set"}}{{end}}</dd></div>
					</dl>
				{{end}}
			</section>

			<section class="w3ds-section w3ds-ppa" aria-labelledby="w3ds-ppa-heading">
				<div class="w3ds-ppa-icon">{{svg "octicon-verified" 32}}</div>
				<div class="w3ds-ppa-content">
					<div class="tw-flex tw-items-center tw-gap-2 tw-flex-wrap">
						<h2 id="w3ds-ppa-heading">{{ctx.Locale.Tr "platform.ppa.title"}}</h2>
						<span class="ui blue label">{{ctx.Locale.Tr "platform.ppa.coming_soon"}}</span>
					</div>
					<p>{{ctx.Locale.Tr "platform.ppa.help"}}</p>
					<ul class="w3ds-ppa-checklist">
						<li data-w3ds-ppa-identity>{{if .PlatformIdentityReady}}{{svg "octicon-check-circle-fill"}}{{svg "octicon-circle" 16 "tw-hidden"}}{{else}}{{svg "octicon-check-circle-fill" 16 "tw-hidden"}}{{svg "octicon-circle"}}{{end}} <span>{{ctx.Locale.Tr "platform.ppa.identity"}}</span> <span class="ui {{if .PlatformIdentityReady}}green{{else}}grey{{end}} label" data-w3ds-requirement-label>{{if .PlatformIdentityReady}}{{ctx.Locale.Tr "platform.repo.ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.waiting"}}{{end}}</span></li>
						<li data-w3ds-ppa-application>{{if $manifest.URL}}{{svg "octicon-check-circle-fill"}}{{svg "octicon-circle" 16 "tw-hidden"}}{{else}}{{svg "octicon-check-circle-fill" 16 "tw-hidden"}}{{svg "octicon-circle"}}{{end}} <span>{{ctx.Locale.Tr "platform.ppa.deployment"}}</span> <span class="ui {{if $manifest.URL}}green{{else}}grey{{end}} label" data-w3ds-requirement-label>{{if $manifest.URL}}{{ctx.Locale.Tr "platform.repo.ready"}}{{else}}{{ctx.Locale.Tr "platform.repo.waiting"}}{{end}}</span></li>
					</ul>
					<button type="button" class="ui primary button" data-w3ds-ppa-apply disabled>{{svg "octicon-verified"}} {{ctx.Locale.Tr "platform.ppa.apply"}}</button>
					<span class="w3ds-ppa-note">{{ctx.Locale.Tr "platform.ppa.disabled_help"}}</span>
				</div>
			</section>
		{{else}}
			<div class="w3ds-empty-state">
				{{svg "octicon-shield-check" 48}}
				<h1>{{ctx.Locale.Tr "platform.repo.setup_title"}}</h1>
				<p>{{ctx.Locale.Tr "platform.repo.setup_help"}}</p>
				<div class="tw-flex tw-gap-2 tw-flex-wrap tw-justify-center">
					<a class="ui primary button" href="{{AppSubUrl}}/repo/create/new">{{ctx.Locale.Tr "platform.new.make"}}</a>
					<a class="ui basic button" href="{{AppSubUrl}}/repo/create/port">{{ctx.Locale.Tr "platform.new.port"}}</a>
				</div>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
