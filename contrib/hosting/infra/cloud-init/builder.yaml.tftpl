#cloud-config
# Untrusted build node: BuildKit plus a Forgejo runner registered only on the
# platform/builder repository. Job containers get the BuildKit socket but
# never the host Docker socket.
package_update: true
packages:
  - ca-certificates
  - curl

write_files:
  - path: /etc/ssh/sshd_config.d/10-gitw3.conf
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin prohibit-password
  - path: /opt/gitw3-builder/image/Dockerfile
    content: |
      ${indent(6, job_image)}
  - path: /opt/gitw3-builder/runner-config.yml
    content: |
      log:
        level: info
      runner:
        capacity: 2
        timeout: 1h
      cache:
        enabled: false
      container:
        network: bridge
        privileged: false
        # Never hand the host Docker daemon to a job.
        docker_host: "-"
        options: "-v /run/buildkit:/run/buildkit"
        valid_volumes:
          - /run/buildkit
        force_pull: false
  - path: /etc/systemd/system/gitw3-prune.service
    content: |
      [Unit]
      Description=Prune build caches on the GitW3 build node
      [Service]
      Type=oneshot
      ExecStart=/usr/bin/docker exec buildkitd buildctl prune --keep-storage 40000
      ExecStart=/usr/bin/docker image prune -af --filter until=72h
      ExecStart=/usr/bin/docker container prune -f --filter until=24h
  - path: /etc/systemd/system/gitw3-prune.timer
    content: |
      [Unit]
      Description=Daily build cache pruning
      [Timer]
      OnCalendar=daily
      RandomizedDelaySec=1h
      Persistent=true
      [Install]
      WantedBy=timers.target

runcmd:
  - systemctl restart ssh || systemctl restart sshd
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable --now docker
  - mkdir -p /run/buildkit
  - docker run -d --name buildkitd --restart always --privileged -v /run/buildkit:/run/buildkit -v buildkit-state:/var/lib/buildkit docker.io/moby/buildkit:v0.17.0 --addr unix:///run/buildkit/buildkitd.sock
  - docker build -t gitw3-builder-job:latest /opt/gitw3-builder/image
  - systemctl daemon-reload
  - systemctl enable --now gitw3-prune.timer
%{ if runner_token != "" ~}
  - mkdir -p /opt/gitw3-builder/runner
  - docker run --rm -v /opt/gitw3-builder/runner:/data -v /opt/gitw3-builder/runner-config.yml:/config.yml:ro code.forgejo.org/forgejo/runner:6 forgejo-runner register --no-interactive --config /config.yml --instance ${forgejo_url} --token ${runner_token} --name ${runner_name} --labels gitw3-builder:docker://gitw3-builder-job:latest
  - docker run -d --name forgejo-runner --restart always -v /opt/gitw3-builder/runner:/data -v /opt/gitw3-builder/runner-config.yml:/config.yml:ro -v /var/run/docker.sock:/var/run/docker.sock code.forgejo.org/forgejo/runner:6 forgejo-runner daemon --config /config.yml
%{ endif ~}
